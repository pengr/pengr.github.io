---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {% if site.title == 'blank' %}
        <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
        {{ site.last_name }}
      {% else %}
        {{ site.title }}
      {% endif %}
    </h1>
    <p class="desc">{{ page.subtitle }}</p>
  </header>

  <article>
    {% if page.profile %}
      <div class="profile float-{% if page.profile.align == 'left' %}left{% else %}right{% endif %}">
        {% if page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% if page.profile.image_circular %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
          {% else %}
            {% assign profile_image_class = 'img-fluid z-depth-1
      rounded' %}
          {% endif %}
          {% capture sizes %}(min-width: {{ site.max_width }}) {{ site.max_width | minus: 30 | times: 0.35}}px, (min-width: 576px)
      35vw, 95vw"{% endcapture %} {%
            include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=page.profile.image
            cache_bust=true
          %}
        {% endif %}
        {% if page.profile.more_info %}
          <div class="more-info">{{ page.profile.more_info }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="clearfix">{{ content }}</div>

    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <h3>
        <a href="{{ '/news/' | relative_url }}" style="color: inherit; font-weight: bold;">🔥 News</a>
      </h3>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Latest posts -->
    <!-- {% if page.latest_posts and page.latest_posts.enabled %}
      <h3>
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit; font-weight: bold;">latest posts</a>
      </h3>
      {% include latest_posts.liquid %}
    {% endif %} -->

    <!-- Selected papers -->
        {% if page.selected_papers %}
      <h3>
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit; font-weight: bold;">📝 Selected Publications</a>
      </h3>
      {% include selected_papers.liquid %}
    {% endif %}


    <!-- Work Experience Section -->
    <h3 style="color: inherit; font-weight: bold;">💼 Work Experience</h3>

    <div class="work-experience">
      <!-- Experience 1: Ant Group -->
      <div class="experience-item" style="margin-bottom: 2rem;">
        <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.5rem;">
          <h4 style="margin: 0; font-weight: bold;">Inclusion AI Team, Ant Group</h4>
          <span style="font-style: italic; color: #666;">April 2025 - Now</span>
        </div>
        <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.5rem;">
          <p style="margin: 0; color: #e91e63; font-weight: 500;">Plan-A Research Intern on Large Language Models</p>
          <span style="color: #666;">Mentor: Junbo Zhao</span>
        </div>
        <p style="margin: 0.5rem 0 0 0;">Contributed to the reinforcement learning from rubric rewards for both closed-ended and open-ended task.</p>
      </div>

      <!-- Experience 2: Alibaba Group -->
      <div class="experience-item" style="margin-bottom: 2rem;">
        <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.5rem;">
          <h4 style="margin: 0; font-weight: bold;">Qwen Pre-training Team, Alibaba Group</h4>
          <span style="font-style: italic; color: #666;">Oct 2023 - April 2025</span>
        </div>
        <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.5rem;">
          <p style="margin: 0; font-weight: 500;">Research Intern on Large Language Models</p>
          <span style="color: #666;">Mentor: Dayiheng Liu, Junyang Lin and Chang Zhou</span>
        </div>
        <ul style="margin: 0.5rem 0 0 0; padding-left: 1.5rem;">
          <li style="margin-bottom: 0.3rem;">Contributed to the <span style="color: #e91e63; font-weight: 500;">Qwen 1.5/2/2.5/3</span> series base models.</li>
          <li style="margin-bottom: 0.3rem;">Developed <span style="color: #e91e63; font-weight: 500;">Data Manager (DataMan and DataMan-X)</span> for data selection and mixing in LLM pre-training, <span style="color: #e91e63; font-weight: 500;">adopted in the Qwen base models and reported in Synced (机器之心)</span>.</li>
          <li>Contributed to <span style="color: #e91e63; font-weight: 500;">data synthesis in open-ended tasks</span> for the Qwen series models.</li>
        </ul>
      </div>

      <!-- Experience 3: Zhejiang University -->
      <div class="experience-item" style="margin-bottom: 2rem;">
        <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.5rem;">
          <h4 style="margin: 0; font-weight: bold;">Institute of Computer Innovation, Zhejiang University</h4>
          <span style="font-style: italic; color: #666;">Sep 2021 - Sep 2022</span>
        </div>
        <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.5rem;">
          <p style="margin: 0; font-weight: 500;">Research Intern on Machine Translation and Automated Model Evaluation</p>
          <span style="color: #666;">Mentor: Junbo Zhao and Peng Lu</span>
        </div>
      </div>

      <!-- Experience 4: NICT -->
      <div class="experience-item" style="margin-bottom: 1rem;">
        <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.5rem;">
          <h4 style="margin: 0; font-weight: bold;">ATTL Lab, NICT</h4>
          <span style="font-style: italic; color: #666;">Jul 2020 - Sep 2021</span>
        </div>
        <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.5rem;">
          <p style="margin: 0; font-weight: 500;">Research Intern (Remote) on Machine Translation</p>
          <span style="color: #666;">Mentor: Kehai Chen</span>
        </div>
      </div>
    </div>

    <br><!-- 添加一个空行 -->

    <!-- Services -->
    <h3 style="color: inherit; font-weight: bold;">📚 Academic Services</h3>
      <ul>
            <li><strong>Conference Reviewer:</strong> ICLR 2024, 2025; ICML 2023, 2025; NeurIPS 2022, 2023, 2024; CVPR 2025; ICCV 2023, 2025; ECCV 2024; ACL 2024; AISTATS 2025; COLM 2024.</li>
            <li><strong>Journal Reviewer:</strong> IEEE Transactions on Big Data (TBD), Transactions of Machine Learning Research (TMLR).</li>
            <li><strong>Publication Chair:</strong> International Conference on Natural Language Processing (ICNLP) 2025.</li>
      </ul>

      <br><!-- 添加一个空行 -->
      <h3 style="color: inherit; font-weight: bold;">😊 Miscellaneous</h3>
        <ul>
              <li>I yearn to be a carefree guitar-playing singer👩‍🎤, strumming melodies of mirth🎵 into life.</li>
              <li>I am a sports enthusiast interested in basketball🏀, outdoor running🏃‍♂️ and so much more.</li>
              <li>I love traveling around the world🗺️, gathering with friends🍻, and trying anything new — except terrible food.</li>
        </ul>
      
      <br><!-- 添加一个空行 -->
      <!-- 添加一个clustrmaps -->
    <div class="row mt-3 justify-content-center">
        <div class="col-sm-6 col-md-4 mt-3 mt-md-0 text-center">
            <div style="max-width: 150px; margin: 0 auto;">
                <script type="text/javascript" id="clstr_globe" src="//clustrmaps.com/globe.js?d=_yjXCBp3edcthw2hhLcp52i3AZZAuzCEaNGD4LT-jxM"></script>
            </div>
        </div>
        <div class="col-sm-6 col-md-4 mt-3 mt-md-0 text-center">
            <img
                id="totoro-audio-player"
                src="{{ '/assets/img/totorobottle.gif' | relative_url }}"
                alt="Totoro Bottle"
                style="cursor: pointer; max-width: 150px; height: auto; display: block; margin: 0 auto;"
                title="Click to play harp music"
            />
            <audio id="harp-audio" src="{{ '/assets/audio/harp.mp3' | relative_url }}" preload="auto"></audio>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const totoroImage = document.getElementById('totoro-audio-player');
            const harpAudio = document.getElementById('harp-audio');

            if (totoroImage && harpAudio) { // Ensure elements exist before adding listeners
                totoroImage.addEventListener('click', function() {
                    if (harpAudio.paused) {
                        harpAudio.play()
                            .catch(e => console.error("Error playing audio:", e));
                    } else {
                        harpAudio.pause();
                        harpAudio.currentTime = 0; // Reset playback to the beginning
                    }
                });
            } else {
                console.warn("Totoro image or harp audio element not found. Audio playback may not work.");
            }
        });
    </script>

    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% include social.liquid %}</div>

        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% include newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
