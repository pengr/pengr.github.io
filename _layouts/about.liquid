        </div>
      </div> -->
    </div>

    <!-- Selected papers -->
        {% if page.selected_papers %}
      <h3>
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit; font-weight: bold;">📝 Selected Publications</a>
      </h3>
      {% include selected_papers.liquid %}
    {% endif %}

   <br><!-- 添加一个空行 -->

    <!-- Services -->
    <h3 style="color: inherit; font-weight: bold;">📚 Academic Services</h3>
      <ul>
            <li><strong>Conference Reviewer:</strong> ICLR 2024, 2025; ICML 2023, 2025; NeurIPS 2022, 2023, 2024; AAAI 2026; CVPR 2025; ICCV 2023, 2025; ECCV 2024; ACL 2024, 2026; AISTATS 2025; COLM 2024.</li>
            <li><strong>Journal Reviewer:</strong> IEEE Transactions on Big Data (TBD), Transactions of Machine Learning Research (TMLR).</li>
